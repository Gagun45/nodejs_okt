{
    "swagger": "2.0",
    "info": {
        "description": "A testing API example",
        "version": "1.0.7",
        "title": "Express API",
        "contact": {
            "email": "selyanchyn45@gmail.com"
        }
    },
    "host": "localhost:3000",
    "schemes": ["http"],
    "tags": [
        {
            "name": "auth",
            "description": "Everything related to authentication process"
        }
    ],
    "paths": {
        "/auth/sign-up": {
            "post": {
                "tags": ["auth"],
                "summary": "register and login",
                "operationId": "sign-up",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "User informaion that needs to be added to the store",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/SignUpUser"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/SignInResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/sign-in": {
            "post": {
                "tags": ["auth"],
                "summary": "login",
                "operationId": "sign-in",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "Sign in credentials",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/SignInCredentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/SignInResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "tags": ["auth"],
                "summary": "Refresh token",
                "operationId": "refresh",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "description": "Requires REFRESH token in Authorization header",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Token refreshed",
                        "schema": {
                            "$ref": "#/definitions/Tokens"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "tags": ["auth"],
                "summary": "Logout from current device",
                "operationId": "logout",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "description": "Requires REFRESH token in Authorization header",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Logout success",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/logout-all": {
            "post": {
                "tags": ["auth"],
                "summary": "Logout from all devices",
                "operationId": "logout-all",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "description": "Requires ACCESS token in Authorization header",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Logout success",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/forgot-password": {
            "post": {
                "tags": ["auth"],
                "summary": "Get the reset-password link on the specified email",
                "operationId": "forgot-password",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "Specify email",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "required": ["email"],
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "format": "email",
                                    "example": "user@example.com"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Reset link sent to the email"
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            },
            "put": {
                "tags": ["auth"],
                "summary": "Set new password during forgot-password flow",
                "operationId": "forgot-password",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "Specify new password",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "required": ["newPassword"],
                            "properties": {
                                "newPassword": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Requires FORGOT_PASSWORD token in Authorization header",
                "responses": {
                    "201": {
                        "description": "New password set",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/verify-account": {
            "post": {
                "tags": ["auth"],
                "summary": "Verify account",
                "operationId": "verify-account",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "description": "Requires VERIFY_ACCOUNT token in Authorization header",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Account verified"
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        },
        "/auth/change-password": {
            "post": {
                "tags": ["auth"],
                "summary": "Change account password",
                "operationId": "change-password",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "description": "Requires ACCESS token in Authorization header",
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "Provide old and new passwords",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "required": ["oldPassword", "newPassword"],
                            "properties": {
                                "oldPassword": {
                                    "type": "string"
                                },
                                "newPassword": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Password changed successfully"
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": { "$ref": "#/definitions/ErrorResponse" }
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header",
            "description": "Bearer token. Format: Bearer <token>"
        }
    },
    "definitions": {
        "SignUpUser": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "age": {
                    "type": "integer",
                    "format": "int32"
                },
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "SignInCredentials": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "Tokens": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string"
                },
                "refreshToken": {
                    "type": "string"
                }
            }
        },
        "SignInResponse": {
            "type": "object",
            "properties": {
                "user": {
                    "$ref": "#/definitions/UserResponse"
                },
                "tokens": {
                    "$ref": "#/definitions/Tokens"
                }
            }
        },
        "UserResponse": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "age": {
                    "type": "integer",
                    "format": "int32"
                },
                "email": {
                    "type": "string"
                },
                "avatar": {
                    "type": "string"
                },
                "isVerified": {
                    "type": "boolean"
                },
                "phone": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "enum": ["user", "admin"]
                }
            },
            "required": ["name", "email", "role", "age", "isVerified"]
        },
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        }
    }
}
